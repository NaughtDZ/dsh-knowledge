{
  "name": "dsh-tavern-knowledge",
  "version": "0.1.0",
  "description": "DSH Tavern 知识库插件：拖拽导入 Office/文本资料，按库独立向量化，每轮把命中片段注入正文请求，支持对话增量向量记忆与整库备份恢复。",
  "type": "module",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "client.js",
    "lib",
    "README.md"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "keywords": [
    "dsh",
    "dsh-tavern",
    "tavern",
    "knowledge-base",
    "rag",
    "embedding",
    "vector-search"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "dsh-tavern-plugin"
      ]
    },
    "compatibility": {
      "tavernApiVersion": 2
    }
  },
  "license": "MIT"
}
